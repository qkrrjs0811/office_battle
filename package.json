{
  "name": "office-battle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run build && vitest run && playwright test",
    "live": "node loop/live.mjs",
    "loop": "node loop/run.mjs",
    "loop:once": "node loop/run.mjs --once",
    "loop:stop": "node -e \"require('fs').writeFileSync('STOP','사용자가 멈춤\n')\""
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
